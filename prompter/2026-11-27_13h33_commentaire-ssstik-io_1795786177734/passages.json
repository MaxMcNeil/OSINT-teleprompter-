 "declencheur": "écoutez ça",
 "ouverture": {
  "start": 46.34,
  "end": 56.6,
  "titre": "Médicament autoréplica dangereux",
  "citation": "Questo cosa vuol dire? Vuol dire che messo nell'organismo questo farmaco ha un'attività esponenziale."
 },
 "passages": [
  {
   "n": 1,
   "start": 1.54,
   "end": 21.86,
   "titre": "Appel à diffuser l'information",
   "citation": "Cari amici, questo è un appello, è un appello e una preghiera di far girare in tutti i modi, diffondere l'informazione, perché purtroppo è stato messo in commercio un nuovo farmaco.",
   "annonce": "Un appel urgent qui sonne comme un cri d’alarme, il incite la France à faire circuler l’information à tout prix."
  },
  {
   "n": 2,
   "start": 22.5,
   "end": 40.28,
   "titre": "Le médicament Kostev",
   "citation": "Questo farmaco si chiama Kostev, è un farmaco sulle basi esattamente del farmaco della famosa pseudovaccinazione che è stata fatta nel tempo, ovvero base MNRA.",
   "annonce": "Il dévoile le nom du produit et le rattache à une technologie déjà controversée."
  },
  {
   "n": 3,
   "start": 71.1,
   "end": 92.62,
   "titre": "Propagation via nos fluides",
   "citation": "cellule ovviamente cercano poi di eliminare queste specie di vescicole che si formano. e queste vescicole vengono immesse nell'ambiente attraverso tutti i nostri liquidi biologici, quindi pensate al sudore, pensate all'urina,",
   "annonce": "Je décris le mécanisme de propagation du produit à travers les fluides biologiques des Français."
  },
  {
   "n": 4,
   "start": 92.625,
   "end": 103.125,
   "titre": "Émission par la respiration",
   "citation": "pensate allo sperma, pensate a tutto quello che noi mettiamo e possiamo mettere nell'ambiente, anche e soprattutto attraverso la respirazione.",
   "annonce": "Il élargit la liste des voies d’émission, incluant même la respiration."
  },
  {
   "n": 5,
   "start": 103.665,
   "end": 127.345,
   "titre": "Demande d'interdiction",
   "citation": "Questo che cosa vuol dire? Vuol dire che noi una volta che assumiamo questo farmaco, che purtroppo è già in commercio, quindi dobbiamo assolutamente contrastare, chiedere al governo di bloccare la vendita, chiedere all'Europa, ai parlamentari europei, non si può andare avanti in questo modo.",
   "annonce": "Il lance un appel à l’action politique, exigeant l’arrêt de la commercialisation."
  },
  {
   "n": 6,
   "start": 145.585,
   "end": 160.005,
   "titre": "Obligation de s'opposer",
   "citation": "Dobbiamo per forza, non è possibile, dobbiamo per forza opporci. Quindi io vi invito, vi prego, di diffondere questa informazione, che è un'informazione che serve a tutti noi, dicevo.",
   "annonce": "Il insiste sur l’impératif de s’opposer à ce fléau, appelant à la mobilisation."
  },
  {
   "n": 7,
   "start": 160.265,
   "end": 174.965,
   "titre": "Risque pour toutes les vies",
   "citation": "Non possiamo rischiare di mettere in gioco la nostra vita e la vita dei nostri figli, nipoti, quelli che verranno in poche parole, ma nello stesso tempo anche gli animali e i vegetali.",
   "annonce": "Il élargit le danger à toutes les formes de vie, humains et non‑humains."
  },
  {
   "n": 8,
   "start": 175.425,
   "end": 182.405,
   "titre": "Conclusion et remerciement",
   "citation": "Allora vi prego, vi invito, diffondete questa informazione. Grazie per avermi ascoltato.",
   "annonce": "Il conclut en réitérant son appel à la diffusion massive de l’avertissement."
  }
 ],
